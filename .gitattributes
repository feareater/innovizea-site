* text=auto
# app-ads.txt is parsed by Google's crawler — pin LF so a Windows checkout can't
# introduce CRLF into the deployed artifact.
app-ads.txt text eol=lf
*.webp binary
*.png binary
*.ico binary
# The downloadable race package — `* text=auto` would mangle the archive.
*.zip binary

# The Thunk playable demo is a Vite BUILD ARTIFACT copied in from the Thunk repo
# (`npm run build:site` there; `npm run check:site` proves this copy is current).
# `* text=auto` above would rewrite its line endings on checkout, and minified
# JavaScript contains template literals with real newlines inside them - so a
# CRLF conversion does not just change bytes, it can change what a string
# CONTAINS. Pinned so what is served is byte-for-byte what was tested.
thunk/play/** -text
